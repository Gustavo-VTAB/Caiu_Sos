<?xml version="1.0" encoding="utf-8"?>
<!-- Card de evento: ícone por tipo, título, quando e onde (máx. 3 informações) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaco_cards"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:padding="@dimen/padding_card">

        <!-- Círculo colorido com ícone, ou com "SOS" no pânico -->
        <FrameLayout
            android:id="@+id/fundoIcone"
            android:layout_width="@dimen/icone_circulo"
            android:layout_height="@dimen/icone_circulo"
            android:background="@drawable/bg_circulo"
            android:importantForAccessibility="noHideDescendants"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/icone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                tools:ignore="ContentDescription"
                tools:src="@drawable/ic_emergencia" />

            <TextView
                android:id="@+id/textoSos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:text="@string/sos"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/titulo"
            style="@style/Texto.Titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@id/quando"
            app:layout_constraintEnd_toStartOf="@id/chevron"
            app:layout_constraintStart_toEndOf="@id/fundoIcone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@string/evento_queda" />

        <TextView
            android:id="@+id/quando"
            style="@style/Texto.Secundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintBottom_toTopOf="@id/endereco"
            app:layout_constraintEnd_toEndOf="@id/titulo"
            app:layout_constraintStart_toStartOf="@id/titulo"
            app:layout_constraintTop_toBottomOf="@id/titulo"
            tools:text="Hoje, 14:32" />

        <TextView
            android:id="@+id/endereco"
            style="@style/Texto.Secundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/titulo"
            app:layout_constraintStart_toStartOf="@id/titulo"
            app:layout_constraintTop_toBottomOf="@id/quando"
            tools:text="Rua XV de Novembro, 1200 – Centro" />

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_direita"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurfaceVariant" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
